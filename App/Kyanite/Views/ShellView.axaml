<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Kyanite.Views.ShellView"

            xmlns:viewLocators="using:Kyanite.ViewLocators"
		   
            x:CompileBindings="False">
    <Panel>
	    <ContentControl Content="{Binding CurrentViewModel}"/>
        
		<!--Dialog system-->
		<!--TODO: move it to another control-->
		<Panel IsVisible="{Binding DialogService.CurrentDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="#99393939"/>

            <DockPanel  VerticalAlignment="Center"
                       HorizontalAlignment="Center" 
                       Background="Black"
                       
                       Width="{Binding DialogService.CurrentDialog.Width}" 
                       Height="{Binding DialogService.CurrentDialog.Height}" >

                <ItemsControl DockPanel.Dock="Bottom" 
                              HorizontalAlignment="Center" 
                              ItemsSource="{Binding DialogService.CurrentDialog.Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}" 
                                    Content="{Binding Content}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Content="{Binding DialogService.CurrentDialog.ViewModel}" >
			        <ContentControl.DataTemplates>        
                        <viewLocators:MainViewLocator/>
			        </ContentControl.DataTemplates>
		        </ContentControl>
		    </DockPanel>
        </Panel>
    </Panel>
</UserControl>